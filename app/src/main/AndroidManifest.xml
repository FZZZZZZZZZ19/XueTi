<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 检查更新 / AI 解题需要联网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 应用内下载 APK 后触发安装 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 重启后恢复每日提醒闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 12+ 精确闹钟（「闹钟与提醒」特殊权限），没有它提醒会被系统延后甚至不触发 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 申请忽略电池优化，避免国产 ROM 杀掉后台后闹钟不触发 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XueTi">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StudyActivity"
            android:exported="false" />

        <activity
            android:name=".StudyHubActivity"
            android:exported="false" />

        <activity
            android:name=".MistakeActivity"
            android:exported="false" />

        <activity
            android:name=".CuratedActivity"
            android:exported="false" />

        <activity
            android:name=".SectionChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".TextbookListActivity"
            android:exported="false" />

        <activity
            android:name=".TextbookCreateActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".TextbookDetailActivity"
            android:exported="false" />

        <activity
            android:name=".SectionStudyActivity"
            android:exported="false" />

        <activity
            android:name=".WordListActivity"
            android:exported="false" />

        <activity
            android:name=".AiSolveActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".StatsActivity"
            android:exported="false" />

        <activity
            android:name=".CropActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- 每日提醒闹钟触发 -->
        <receiver
            android:name=".work.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.xueti.learn.action.DAILY_REMIND" />
                <action android:name="com.xueti.learn.action.OFF_PEAK" />
            </intent-filter>
        </receiver>

        <!-- 开机 / 应用更新 / 恢复出厂 后恢复闹钟；精确闹钟权限变化时也重排 -->
        <receiver
            android:name=".work.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 供应用内下载的 APK 安装、拍照输出使用 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
